{
  "multipart": [
    {
      "when": {
        "powered": "false",
        "facing": "north"
      },
      "apply": {
        "model": "riley_mod:block/shut_off_deactivated",
        "y": 0
      }
    },
    {
      "when": {
        "powered": "false",
        "facing": "east"
      },
      "apply": {
        "model": "riley_mod:block/shut_off_deactivated",
        "y": 90
      }
    },
    {
      "when": {
        "powered": "false",
        "facing": "south"
      },
